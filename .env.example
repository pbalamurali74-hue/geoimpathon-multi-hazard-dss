# GEOIMPATHON 1.0 - Local Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Google Earth Engine Google Cloud Project ID
# Required ONLY if running live online Earth Engine data extractions
GEE_PROJECT=geoimpathon-dss

# Optional: Maps API Keys
# If provided, enables Google Maps Platform features and quota-allocated tiles
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=
CARTO_API_KEY=
