# GEOIMPATHON 1.0 - Local Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Google Earth Engine Google Cloud Project ID
# Required ONLY if running live online Earth Engine data extractions
GEE_PROJECT=your-gcp-project-id

# Optional: CartoDB Basemap Key (if using custom paid CartoDB tiles)
CARTO_API_KEY=your-cartodb-api-key
